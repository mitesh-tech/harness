"""Tests for {{ service }}, generated from the confirmed spec before its code.

Black-box: each test sends HTTP requests only. `given` data is set up through
the database session, so the tests don't depend on the code under test.
"""

import importlib

import pytest


def create(session, entity: str, module: str, values: dict, **parents):
    """Set up a row the test needs (the spec's `given`)."""
    model = getattr(importlib.import_module(f"{{ models_module }}.{module}"), entity)
    row = model(**values, **parents)
    session.add(row)
    session.commit()
    session.refresh(row)
    return row


def same(actual, expected) -> bool:
    if isinstance(expected, float):
        return float(actual) == pytest.approx(expected)
    return actual == expected
