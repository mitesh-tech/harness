{
  "$defs": {
    "SemIfSettings": {
      "additionalProperties": false,
      "description": "Where the decision model runs and how sure it must be.",
      "properties": {
        "url": {
          "default": "http://localhost:8010/v1/systemone",
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "threshold": {
          "default": 0.8,
          "maximum": 1,
          "minimum": 0,
          "title": "Threshold",
          "type": "number"
        },
        "timeout": {
          "default": 30,
          "exclusiveMinimum": 0,
          "title": "Timeout",
          "type": "number"
        }
      },
      "title": "SemIfSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The link between a project and the harness.",
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "pack": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "title": "Pack",
      "type": "string"
    },
    "knowledge": {
      "default": ".harness",
      "minLength": 1,
      "title": "Knowledge",
      "type": "string"
    },
    "semif": {
      "$ref": "#/$defs/SemIfSettings"
    }
  },
  "required": [
    "version",
    "pack"
  ],
  "title": "HarnessFile",
  "type": "object"
}
