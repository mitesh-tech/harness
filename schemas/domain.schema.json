{
  "$defs": {
    "Area": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "title": "Area",
      "type": "object"
    },
    "Association": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "composition",
            "aggregation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "title": "Parent",
          "type": "string"
        },
        "child": {
          "pattern": "^[A-Z][A-Za-z0-9]*$",
          "title": "Child",
          "type": "string"
        },
        "cardinality": {
          "enum": [
            "one_to_many",
            "many_to_many"
          ],
          "title": "Cardinality",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "parent",
        "child",
        "cardinality"
      ],
      "title": "Association",
      "type": "object"
    },
    "Attribute": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "id",
            "text",
            "integer",
            "money",
            "date",
            "datetime",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        }
      },
      "required": [
        "type"
      ],
      "title": "Attribute",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Area",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "identifier": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Identifier",
          "type": "string"
        },
        "attributes": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/Attribute"
            }
          },
          "title": "Attributes",
          "type": "object"
        },
        "lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lifecycle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "area",
        "description",
        "identifier",
        "attributes"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Lifecycle": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Field",
          "type": "string"
        },
        "initial": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Initial",
          "type": "string"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "minItems": 1,
          "title": "Transitions",
          "type": "array"
        }
      },
      "required": [
        "field",
        "initial",
        "transitions"
      ],
      "title": "Lifecycle",
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "examples": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Examples",
          "type": "array"
        },
        "not": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kind",
          "type": "string"
        },
        "acts_on": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Za-z0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acts On"
        },
        "association": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Association"
        },
        "within": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Za-z0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Within"
        },
        "filters": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Filters",
          "type": "array"
        },
        "changes": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Changes",
          "type": "array"
        },
        "moves": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "description",
        "kind"
      ],
      "title": "Service",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "Transition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "areas": {
      "maxProperties": 20,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/Area"
        }
      },
      "title": "Areas",
      "type": "object"
    },
    "entities": {
      "minProperties": 1,
      "patternProperties": {
        "^[A-Z][A-Za-z0-9]*$": {
          "$ref": "#/$defs/Entity"
        }
      },
      "title": "Entities",
      "type": "object"
    },
    "associations": {
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/Association"
        }
      },
      "title": "Associations",
      "type": "object"
    },
    "services": {
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "$ref": "#/$defs/Service"
        }
      },
      "title": "Services",
      "type": "object"
    }
  },
  "required": [
    "areas",
    "entities",
    "services"
  ],
  "title": "Domain",
  "type": "object"
}
